{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "iapTest": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "KAPP_BUILD_PROFILE": "iapTest",
        "EXPO_PUBLIC_DEV_UNLOCK_ALL": "0",
        "EXPO_PUBLIC_INTERNAL_PREMIUM_ACCESS": "0",
        "EXPO_PUBLIC_ENABLE_NATIVE_IAP": "1",
        "EXPO_PUBLIC_REVENUECAT_STORE": "test"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_INTERNAL_PREMIUM_ACCESS": "1",
        "EXPO_PUBLIC_ENABLE_NATIVE_IAP": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEV_UNLOCK_ALL": "0",
        "EXPO_PUBLIC_INTERNAL_PREMIUM_ACCESS": "1",
        "EXPO_PUBLIC_ENABLE_NATIVE_IAP": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "closedTest": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEV_UNLOCK_ALL": "0",
        "EXPO_PUBLIC_INTERNAL_PREMIUM_ACCESS": "1",
        "EXPO_PUBLIC_ENABLE_NATIVE_IAP": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEV_UNLOCK_ALL": "0",
        "EXPO_PUBLIC_INTERNAL_PREMIUM_ACCESS": "0",
        "EXPO_PUBLIC_ENABLE_NATIVE_IAP": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
