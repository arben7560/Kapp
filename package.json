{
  "name": "k-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --port 8082",
    "start:clear": "expo start --port 8082 --clear",
    "start:tunnel": "expo start --port 8082 --tunnel --clear",
    "dev-client": "expo start --port 8082 --dev-client",
    "dev-client:clear": "expo start --port 8082 --dev-client --clear",
    "dev-client:tunnel": "expo start --port 8082 --dev-client --tunnel --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:font-fallback": "node ./scripts/start-font-fallback.mjs",
    "test:cafe-speech": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-cafe-speech.mjs",
    "test:cafe-speech-diagnostics": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-cafe-speech-diagnostics.mjs",
    "test:cafe-summary": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-cafe-conversation-summary.mjs",
    "test:metro-speech": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-metro-speech.mjs",
    "test:restaurant-speech": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-restaurant-speech.mjs",
    "test:aeroport-speech": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-aeroport-speech.mjs ./scripts/test-aeroport-intent-regressions.mjs",
    "test:counting-audio": "node --test ./scripts/test-counting-audio.mjs",
    "test:hangul": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-hangul-curriculum.mjs",
    "test:grammar": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-grammar-registry.mjs ./scripts/test-grammar-experience.mjs ./scripts/test-grammar-responsive.mjs",
    "test:choices": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-choice-order.mjs",
    "test:listen": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-listen.mjs",
    "test:media": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-media-lifecycle.mjs",
    "test:premium": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-premium.mjs",
    "test:immersion": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-immersion-scenes.mjs",
    "test:streak": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-daily-streak.mjs",
    "test:auth-sync": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-auth-sync.mjs",
    "test:auth-production": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-auth-production.mjs",
    "test:progress-cloud": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-progress-cloud-contract.mjs",
    "validate:ui": "node ./scripts/validate-ui-contracts.mjs",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-kr": "^0.4.3",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-canvas": "^0.1.40",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.6.0",
    "react-native-purchases-ui": "^10.6.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "supabase": "^2.114.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
