    "test:navigation:browser": "node --test --test-isolation=none ./scripts/test-module-navigation-browser.mjs",
    "test:navigation:native": "node --test --test-isolation=none ./scripts/test-module-navigation-native.mjs",
    "test:hangul": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-hangul-curriculum.mjs",
