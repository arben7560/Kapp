    "test:choices": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-choice-order.mjs",
    "test:listen": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-listen.mjs",
    "test:media": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-media-lifecycle.mjs",
    "test:premium": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-premium.mjs",
    "test:immersion": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-immersion-scenes.mjs",
    "test:streak": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-daily-streak.mjs",
    "test:auth-sync": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-auth-sync.mjs",
    "test:auth-production": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-auth-production.mjs ./scripts/test-auth-cloud.mjs",
    "test:oauth": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-oauth-flow.mjs",
    "test:progress-cloud": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-progress-cloud-contract.mjs",
    "validate:ui": "node ./scripts/validate-ui-contracts.mjs",
    "validate:i18n": "node --experimental-strip-types ./scripts/validate-i18n.mjs",
    "validate:i18n:release-ja": "node --experimental-strip-types ./scripts/validate-i18n.mjs --release-ja",
    "test:i18n": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-i18n.mjs ./scripts/test-i18n-typography.mjs ./scripts/test-i18n-first-run.mjs",
    "lint": "expo lint",
    "test:vocabulary": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-vocabulary-localization.mjs",
    "test:counting-localization": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-counting-localization.mjs",
    "test:classifiers-localization": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-classifiers-localization.mjs"
    "test:grammar-localization": "node --test --test-isolation=none --experimental-strip-types ./scripts/test-grammar-localization.mjs",
