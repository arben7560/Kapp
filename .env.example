# Supabase public client configuration. Never expose a service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Progress snapshots use the fixed public.user_progress migration contract.
EXPO_PUBLIC_SUPABASE_DELETE_ACCOUNT_FUNCTION=delete-account

# RevenueCat public SDK keys. Never put RevenueCat secret API keys here.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_android_key
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_ios_key

# Development client only: RevenueCat Test Store public key.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_your_public_test_store_key

# Development-only Premium bypass. Set to 0 to test the locked state.
EXPO_PUBLIC_DEV_UNLOCK_ALL=1

# Internal APK only: grants Premium access in a release-mode preview build.
# Keep this at 0 outside the EAS preview profile.
EXPO_PUBLIC_INTERNAL_PREMIUM_ACCESS=0

# Set to 1 in a development client to exercise native RevenueCat flows.
# Release builds enable native IAP by default unless explicitly set to 0.
EXPO_PUBLIC_ENABLE_NATIVE_IAP=1
