{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    // Historical screen variants, not Expo Router routes. See docs/typescript-scope.md.
    "app-index-hdplus-patch.tsx",
    "app-index-tall-layout.tsx",
    "app-onboarding-hdplus-patch.tsx",
    "app-onboarding-tall-layout.tsx",
    "onboarding.tsx"
  ]
}
